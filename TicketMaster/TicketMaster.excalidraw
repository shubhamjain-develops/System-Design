    {
      "type": "text",
      "version": 666,
      "versionNonce": 368833716,
      "isDeleted": false,
      "id": "gevr1BMrK7LQibbwJ3QG5",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 2676.2117163109388,
      "y": 1630.3139255239864,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 1054.6875,
