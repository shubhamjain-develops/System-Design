      "fontSize": 30,
      "fontFamily": 3,
      "text": "Bit.ly is a URL shortening service that converts long URLs into shorter, manageable links. It also provides analytics for the\nshortened URLs.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bit.ly is a URL shortening service that converts long URLs into shorter, manageable links. It also provides analytics for the\nshortened URLs.",
