      "boundElements": [],
      "updated": 1789904256987,
      "link": null,
      "locked": false,
      "fontSize": 28,
      "fontFamily": 3,
      "text": "API: 1.GET /comment: Gets the latest comments, \n     triggered when a new user joins a stream.\n     Given the scale of this will give the user \n     last 200 comments, and rest will be updated \n     based on pagination params when the user \n     scrolls up to see previous. pagination will \n     be done based on comment_timestamp.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "API: 1.GET /comment: Gets the latest comments, \n     triggered when a new user joins a stream.\n     Given the scale of this will give the user \n     last 200 comments, and rest will be updated \n     based on pagination params when the user \n     scrolls up to see previous. pagination will \n     be done based on comment_timestamp.",
      "lineHeight": 1.2,
      "baseline": 229
    },
