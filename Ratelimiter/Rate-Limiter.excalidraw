    {
      "id": "t64ndxKR3hpQBCoPb_R0N",
      "type": "text",
      "x": 1587.5158730158735,
      "y": 2695.4166666666665,
      "width": 850.9794311523438,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#404040",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b18",
      "roundness": null,
      "seed": 593041533,
      "version": 518,
      "versionNonce": 313779933,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788505258373,
      "link": null,
      "locked": false,
      "text": "Sliding Window Counter: here we calculate the weight of a request and if that is higher\nthen the limit we do not allow it. The formula to calculate weight is \nw = [1 - x%] * Last_Window_Request + Current_Window_Request;\nx is proportion of request time within the current window.\n\nPROS: 1. More precise then fixed window. 2. Easier than sliding window.\nCONS: 1. Not as precise as sliding window.\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sliding Window Counter: here we calculate the weight of a request and if that is higher\nthen the limit we do not allow it. The formula to calculate weight is \nw = [1 - x%] * Last_Window_Request + Current_Window_Request;\nx is proportion of request time within the current window.\n\nPROS: 1. More precise then fixed window. 2. Easier than sliding window.\nCONS: 1. Not as precise as sliding window.\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
