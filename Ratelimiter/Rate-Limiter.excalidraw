      "updated": 1788467341747,
      "link": null,
      "locked": false,
      "text": "res = redis.getvalue(key);\nif(res == null){\n    res = currtimestamp+'#'+'1';\n    redis.Setvalue(key , currtimestamp+'#'+'1', 10sec) \n}\nvar resarr = res.split('#');\ntimestamp = res[0];\ncount = res[1];\nif(currtime - timestamp < 10 && count => 5){ return false; }\nif(currtime - timestamp <10 && count < 5) {count++; redis.Setvalue(key , timestamp +'#'+count, 10sec);}\nif(currtime - timestamp > 10) {redis.Setvalue(key , currtimestamp+'#'+'1', 10sec);}\n\nreturn true;",
      "fontSize": 21.15555555555561,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "res = redis.getvalue(key);\nif(res == null){\n    res = currtimestamp+'#'+'1';\n    redis.Setvalue(key , currtimestamp+'#'+'1', 10sec) \n}\nvar resarr = res.split('#');\ntimestamp = res[0];\ncount = res[1];\nif(currtime - timestamp < 10 && count => 5){ return false; }\nif(currtime - timestamp <10 && count < 5) {count++; redis.Setvalue(key , timestamp +'#'+count, 10sec);}\nif(currtime - timestamp > 10) {redis.Setvalue(key , currtimestamp+'#'+'1', 10sec);}\n\nreturn true;",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
