    {
      "id": "1nnDjHrYk3Sx8qPnkCU8J",
      "type": "text",
      "x": 867.5158730158735,
      "y": 1716.6666666666665,
      "width": 8,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
