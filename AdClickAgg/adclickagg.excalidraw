    {
      "type": "text",
      "version": 2,
      "versionNonce": 1758914541,
      "isDeleted": false,
      "id": "hi-subtitle-cmu6qipfb1zfh08adg4254bcm",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
