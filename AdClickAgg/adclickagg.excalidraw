      "fontSize": 20,
      "fontFamily": 3,
      "text": "Consumer \nkafka sends the click count to a consumer\nthat sends it to the db to store.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Consumer \nkafka sends the click count to a consumer\nthat sends it to the db to store.",
      "lineHeight": 1.2,
      "baseline": 67
    },
